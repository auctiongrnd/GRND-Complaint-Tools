{
  "manifest_version": 3,
  "name": "GRND Complaint Tools",
  "version": "1.5.1",
  "description": "Custom verdict templates, favorites, dark theme, searchable report history, and release updates for GRND admins",

  "content_scripts": [
    {
      "matches": [
        "https://grnd.gg/admin/complaints/*",
        "https://eu.grnd.gg/admin/complaints/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["clipboardWrite", "storage"],

  "host_permissions": [
    "https://grnd.gg/*",
    "https://eu.grnd.gg/*",
    "https://rkzmkdjkldcukbaewywn.supabase.co/*"
  ]
}