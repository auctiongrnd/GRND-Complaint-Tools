{
  "manifest_version": 3,
  "name": "GRND Complaint Tools",
  "version": "1.6.0",
  "description": "Complaint tools with synced player directories, opt-in admin analytics, account-linked feature access, and extension updates",

  "content_scripts": [
    {
      "matches": [
        "https://grnd.gg/admin/*",
        "https://eu.grnd.gg/admin/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["clipboardWrite", "storage"],

  "host_permissions": [
    "https://grnd.gg/*",
    "https://eu.grnd.gg/*",
    "https://rkzmkdjkldcukbaewywn.supabase.co/*"
  ]
}